invariant Nonnegative {
    (forall u : address . w0[u] >= 0 && w1[u] >= 0 && c0[u] >= 0 && c1[u] >= 0
                          && debt[u] >= 0)
    && res0 >= 0 && p1 > 0
}

// No user other than the oracle can make a healthy user unhealthy.
property Health_non_interference {
    forall a : address . forall b : address .
    forall f : method . forall args : calldataargs .
    (is_EOA(a) && a != b && b != oracle && (c0[a] + c1[a] * p1) * 4 >= debt[a] * 5) ->
    << b : Lending.f(args) >> (c0[a] + c1[a] * p1) * 4 >= debt[a] * 5
}

// Defence against liquidation (Thm 5.1), with an explicit strategy: repay the whole debt.
property Liquidation_defence {
    forall a : address .
    (is_EOA(a) && (c0[a] + c1[a] * p1) * 4 < debt[a] * 5 && w0[a] >= debt[a]) ->
    << a : Lending.repay(debt[a]) >>
        forall b : address . forall v : int . << b : Lending.liquidate(a, v) >> lastReverted
}

// Defence against liquidation (Thm 5.1): an unhealthy user who holds enough T0 can act so
// that every liquidation of it fails.
property Liquidation_defence_exists {
    forall a : address .
    (is_EOA(a) && (c0[a] + c1[a] * p1) * 4 < debt[a] * 5 && w0[a] >= debt[a]) ->
    exists f : method . exists args : calldataargs .
    << a : Lending.f(args) >>
        forall b : address . forall v : int . << b : Lending.liquidate(a, v) >> lastReverted
}

// Liquidation attack (Thm 6.2), with an explicit strategy: set the price to
// debt[b] / (2 * c1[b]) (b becomes unhealthy, unless the price rounds down to 0 and the call
// reverts), liquidate debt[b] / 4, restore the price.
property Liquidation_attack {
    forall a : address . forall b : address .
    (is_EOA(a) && is_EOA(b) && a != b && a != oracle && w0[a] >= debt[b] / 4
     && debt[b] > 0 && c1[b] > 0 && c0[b] == 0
     && (c0[b] + c1[b] * p1) * 4 >= debt[b] * 5) ->
    << a : Lending.setPrice(debt[b] / (2 * c1[b])) >> << a : Lending.liquidate(b, debt[b] / 4) >>
    << a : Lending.setPrice(old(old(p1))) >>
        w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a] >
        old(old(old(w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a])))
}

// Liquidation attack (Thm 6.2): whoever can move the price can profitably liquidate a
// healthy borrower whose collateral is in T1 (lower the price, liquidate, restore the price).
property Liquidation_attack_exists {
    forall a : address . forall b : address .
    (is_EOA(a) && is_EOA(b) && a != b && a != oracle && w0[a] > 0
     && debt[b] > 0 && c1[b] > 0 && c0[b] == 0
     && (c0[b] + c1[b] * p1) * 4 >= debt[b] * 5) ->
    exists p : int . exists v : int .
    << a : Lending.setPrice(p) >> << a : Lending.liquidate(b, v) >>
    << a : Lending.setPrice(old(old(p1))) >>
        w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a] >
        old(old(old(w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a])))
}

// Liquidation attack (Thm 6.2), without a given strategy: some sequence of three calls of
// a (a call that reverts leaves the state unchanged) increases its net worth.
property Liquidation_attack_any {
    forall a : address . forall b : address .
    (is_EOA(a) && is_EOA(b) && a != b && a != oracle && w0[a] > 0
     && debt[b] > 0 && c1[b] > 0 && c0[b] == 0
     && (c0[b] + c1[b] * p1) * 4 >= debt[b] * 5) ->
    exists f1 : method . exists args1 : calldataargs .
    exists f2 : method . exists args2 : calldataargs .
    exists f3 : method . exists args3 : calldataargs .
    << a : Lending.f1(args1) >> << a : Lending.f2(args2) >> << a : Lending.f3(args3) >>
        w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a] >
        old(old(old(w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a])))
}

// Deposits, redeems, borrows and repays do not change the net worth of anyone.
property Net_worth_preserved {
    forall a : address . forall b : address . forall f : method . forall args : calldataargs .
    (f == Lending.deposit0 || f == Lending.redeem0 || f == Lending.deposit1
     || f == Lending.redeem1 || f == Lending.borrow || f == Lending.repay) ->
    << b : Lending.f(args) >>
        w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a] ==
        old(w0[a] + w1[a] * p1 + c0[a] + c1[a] * p1 - debt[a])
}

// A healthy user can undo a deposit.
property Deposit_reversibility {
    forall a : address . forall v : int .
    ((c0[a] + c1[a] * p1) * 4 >= debt[a] * 5) ->
    << a : Lending.deposit0(v) >>
        (lastReverted ||
         << a : Lending.redeem0(v) >> (w0[a] == old(old(w0[a])) && c0[a] == old(old(c0[a]))))
}

// A borrower is healthy after borrowing.
property Borrow_safe {
    forall a : address . forall v : int .
    << a : Lending.borrow(v) >> (lastReverted || (c0[a] + c1[a] * p1) * 4 >= debt[a] * 5)
}

// Only unhealthy users can be liquidated.
property Liquidation_only_unhealthy {
    forall a : address . forall b : address . forall v : int .
    ((c0[b] + c1[b] * p1) * 4 >= debt[b] * 5) ->
    << a : Lending.liquidate(b, v) >> lastReverted
}
