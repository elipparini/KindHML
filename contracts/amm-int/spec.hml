// Invariants, proved inductive by the tool and assumed when checking the properties. The pool is
// empty before the first deposit and after the redemption of the whole supply, so the
// reserves are only nonnegative (unlike amm-simple-int, where they are always positive).
invariant Nonnegative {
    (forall u : address . t0[u] >= 0 && t1[u] >= 0 && minted[u] >= 0)
    && r0 >= 0 && r1 >= 0 && supply >= 0
    && (r0 > 0) == (r1 > 0) && (supply > 0) == (r0 > 0)
}

// Only users hold liquidity, and the minted liquidity of any two addresses is at most the
// supply (with two users, the supply is the sum of the minted liquidity).
invariant Shares {
    (forall w : address . !is_EOA(w) -> minted[w] == 0)
    && forall u : address . forall v : address . u != v -> minted[u] + minted[v] <= supply
}

// Slippage protection: a swap that succeeds pays at least ymin.
property Slippage {
    forall a : address . forall x : int . forall ymin : int .
    << a : AMM.swap0(x, ymin) >> (lastReverted || t1[a] >= old(t1[a]) + ymin)
}

// Sandwich attack, with an explicit strategy: adv front-runs with all its tokens T0. The
// pool must not be empty (r0 > 0), otherwise the swaps revert.
property Sandwich {
    forall a : address . forall adv : address . forall x : int .
    (is_EOA(a) && is_EOA(adv) && a != adv && r0 > 0 && x > 0 && t0[a] >= x && t0[adv] > 0) ->
    << adv : AMM.swap0(t0[adv], 0) >> << a : AMM.swap0(x, 0) >>
    << adv : AMM.swap1(t1[adv] - old(old(t1[adv])), 0) >>
        (t0[adv] > old(old(old(t0[adv]))) && t1[adv] == old(old(old(t1[adv]))))
}

// Sandwich attack against a slippage bound: if the victim accepts less than what its swap
// would pay now (ymin < x * r1 / (r0 + x)), any other user with tokens T0 can front-run it
// with some amount z (small enough for the victim's swap to succeed) and gain.
property Sandwich_slippage {
    forall a : address . forall adv : address . forall x : int . forall ymin : int .
    (is_EOA(a) && is_EOA(adv) && a != adv && r0 > 0 && x > 0 && t0[a] >= x && t0[adv] > 0
     && ymin * (r0 + x) < x * r1) ->
    exists z : int .
    << adv : AMM.swap0(z, 0) >> << a : AMM.swap0(x, ymin) >>
        (!lastReverted
         && << adv : AMM.swap1(t1[adv] - old(old(t1[adv])), 0) >>
            (t0[adv] > old(old(old(t0[adv]))) && t1[adv] == old(old(old(t1[adv])))))
}

// Splitting a swap gives the same as a single swap (no incentive to split).
property Swap_additivity {
    forall a : address . forall x1 : int . forall x2 : int .
    exists v12 : int . exists v3 : int .
    exists q1 : bool . exists q2 : bool . exists q3 : bool .
    (<< a : AMM.swap0(x1, 0) >> (q1 == lastReverted &&
        << a : AMM.swap0(x2, 0) >> (q2 == lastReverted && v12 == t1[a])))
    && (<< a : AMM.swap0(x1 + x2, 0) >> (q3 == lastReverted && v3 == t1[a]))
    && (q1 || q2 || (!q3 && v12 == v3))
}

// A swap can be undone by an opposite swap.
property Swap_reversibility {
    forall a : address . forall x : int . exists y : int .
    << a : AMM.swap0(x, 0) >>
        (lastReverted ||
         << a : AMM.swap1(y, 0) >>
            (t0[a] == old(old(t0[a])) && t1[a] == old(old(t1[a]))))
}

// A deposit can be undone by a redemption.
property Deposit_reversibility {
    forall a : address . forall x0 : int . forall x1 : int . exists l : int .
    << a : AMM.deposit(x0, x1) >>
        (lastReverted ||
         << a : AMM.redeem(l) >>
            (t0[a] == old(old(t0[a])) && t1[a] == old(old(t1[a]))))
}

// A liquidity provider can always exit.
property LP_exit {
    forall a : address .
    (is_EOA(a) && minted[a] > 0) ->
    << a : AMM.redeem(minted[a]) >> (!lastReverted && minted[a] == 0)
}

// No round trip of swaps is profitable (no money pump).
property No_money_pump {
    forall a : address . forall x : int . forall y : int .
    << a : AMM.swap0(x, 0) >> << a : AMM.swap1(y, 0) >>
        (!(t0[a] > old(old(t0[a])) && t1[a] >= old(old(t1[a])))
         && !(t0[a] >= old(old(t0[a])) && t1[a] > old(old(t1[a]))))
}

// Arbitrage, with an explicit strategy (as in amm_real.sol; amounts rounded down).
property Arbitrage {
    forall a : address . forall p : int .
    (is_EOA(a) && p > 0 && r0 > 0 && t0[a] > 0 && r1 > p * r0) ->
    ((t0[a] < r1 / p - r0 ->
        << a : AMM.swap0(t0[a], 0) >> (p * t0[a] + t1[a] > old(p * t0[a] + t1[a])))
     && (t0[a] >= r1 / p - r0 ->
        << a : AMM.swap0((r1 / p - r0) / 2, 0) >> (p * t0[a] + t1[a] > old(p * t0[a] + t1[a]))))
}

// Arbitrage: if the AMM price of T0 (r1 / r0) is above an external price p, some swap
// increases the wealth at price p.
property Arbitrage_exists {
    forall a : address . forall p : int .
    (is_EOA(a) && p > 0 && r0 > 0 && t0[a] > 0 && r1 > p * r0) ->
    exists x : int .
    << a : AMM.swap0(x, 0) >> (p * t0[a] + t1[a] > old(p * t0[a] + t1[a]))
}
